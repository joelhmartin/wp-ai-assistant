# Deny everything at the WP root, then allow only what this repo tracks.
/*

# Top-level allow list
!/.gitignore
!/CLAUDE.md
!/wp-content/

# Inside wp-content: deny everything, then allow only themes/ and plugins/
/wp-content/*
!/wp-content/themes/
!/wp-content/plugins/

# Inside themes/: only the child theme we own.
# anchor-framework lives in its own repo (joelhmartin/anchor-framework)
# and is installed/updated on each site via the WP updater UI.
/wp-content/themes/*
!/wp-content/themes/anchor-starter-child/

# Inside plugins/: nothing tracked here.
# anchor-page-assistant lives in its own repo
# (joelhmartin/anchor-page-assistant) and is installed/updated on each
# site via the WP updater UI.
/wp-content/plugins/*

# Common build / local-only junk inside our tracked dirs
**/node_modules/
**/.DS_Store
**/*.log
**/.bak
**/*.bak
**/*.swp
**/*.tmp
**/.vscode/
**/.idea/
